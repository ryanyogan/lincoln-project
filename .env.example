# =============================================================================
# Required
# =============================================================================

# Database (Docker default — no change needed for local dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lincoln_dev

# Phoenix
SECRET_KEY_BASE=your-secret-key-base-here
PHX_HOST=localhost
PORT=4000

# Python ML Service (Docker default — no change needed for local dev)
ML_SERVICE_URL=http://localhost:8000

# Claude API (required for frontier inference)
ANTHROPIC_API_KEY=your-api-key-here

# =============================================================================
# Web Search (at least one recommended for investigation grounding)
# =============================================================================

# SearXNG: self-hosted meta-search engine. Free, unlimited, no API key.
# Start with: docker compose --profile search up -d
# Aggregates Google, DuckDuckGo, Bing, Wikipedia results.
# Recommended as primary search — $0/month at any volume.
SEARXNG_URL=http://localhost:8888

# Tavily: AI-optimized search API. 1000 free queries/month.
# Used as fallback when SearXNG is unavailable or returns empty results.
# Get a key at https://tavily.com
TAVILY_API_KEY=

# Firecrawl: combined search + scrape. Returns full-page markdown.
# More expensive per-query but richer content for deep reads.
# Run as stdio subprocess via `npx -y firecrawl-mcp` (requires Node on PATH).
# Get a key at https://firecrawl.dev/
FIRECRAWL_API_KEY=

# Search precedence (auto-configured from the keys above):
#   1. SearXNG (if SEARXNG_URL set) — free, unlimited
#   2. Tavily (if TAVILY_API_KEY set) — 1000 free/month
#   3. Firecrawl (if FIRECRAWL_API_KEY set) — per-query cost
# Results cached in ETS for 1 hour. Rate limited to 10 queries/minute.
# If nothing is configured, investigation runs without web grounding.

# =============================================================================
# Optional Services
# =============================================================================

# Context7: up-to-date library docs for self-modification pipeline.
# https://context7.com/ — API key optional.
CONTEXT7_API_KEY=

# Fetch MCP: page reading via the official Anthropic stdio MCP server.
# Optional — Firecrawl already covers most read use cases via its scrape tool.
# Requires `uvx` (from `uv`) on PATH; install with: pipx install uv
LINCOLN_FETCH_ENABLED=false

# LLM provider override. Default: anthropic.
# Set to "openai" + OPENAI_API_KEY to use OpenAI models instead.
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=

# Local inference for conversation and cognitive work (no cloud model fallback).
# This controls model inference, not separately configured web research providers.
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
