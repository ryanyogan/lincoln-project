# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lincoln_dev

# Phoenix
SECRET_KEY_BASE=your-secret-key-base-here
PHX_HOST=localhost
PORT=4000

# Python ML Service
ML_SERVICE_URL=http://localhost:8000

# Claude API
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Local model inference
# LOCAL_MODEL_PATH=/path/to/model

# Outbound MCP servers — Lincoln's senses
# Firecrawl: web search + scrape in one call. Returns markdown content
# alongside each result. Run as a stdio subprocess via `npx -y firecrawl-mcp`
# (requires Node on PATH). Get a key at https://firecrawl.dev/.
FIRECRAWL_API_KEY=
# Context7: up-to-date library docs at https://context7.com/. API key optional.
CONTEXT7_API_KEY=
# Fetch: page reading via the official Anthropic stdio MCP server.
# Optional — Firecrawl already covers most read use cases via its scrape tool.
# Requires `uvx` (from `uv`) on PATH; install with: pipx install uv
LINCOLN_FETCH_ENABLED=false
